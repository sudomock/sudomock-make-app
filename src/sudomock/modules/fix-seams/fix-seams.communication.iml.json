[
  {
    "url": "/fix-seams",
    "method": "POST",
    "headers": {
      "Idempotency-Key": "{{if(parameters.idempotency_key, parameters.idempotency_key, undefined)}}"
    },
    "body": {
      "url": "{{parameters.url}}",
      "base64": "{{parameters.base64}}",
      "crop_aspect": "{{parameters.crop_aspect}}"
    },
    "response": {
      "temp": {
        "accepted": "{{body}}",
        "jobId": "{{body.job_id}}",
        "startedAt": "{{now}}"
      }
    }
  },
  {
    "url": "/jobs/{{temp.jobId}}",
    "method": "GET",
    "condition": "{{parameters.wait_for_completion && temp.jobId}}",
    "repeat": {
      "condition": "{{parameters.wait_for_completion && temp.jobId && temp.status != 'succeeded' && temp.status != 'failed' && temp.status != 'cancelled' && now < addSeconds(temp.startedAt, ifempty(parameters.poll_timeout, 300))}}",
      "delay": 3000,
      "limit": 101
    },
    "response": {
      "temp": {
        "finalJob": "{{body}}",
        "status": "{{body.status}}"
      }
    }
  },
  {
    "condition": "{{parameters.wait_for_completion && temp.jobId}}",
    "response": {
      "valid": {
        "condition": "{{temp.status == 'succeeded' || temp.status == 'failed' || temp.status == 'cancelled' || now < addSeconds(temp.startedAt, ifempty(parameters.poll_timeout, 300))}}",
        "message": "Polling timed out before the job reached a terminal status.",
        "type": "DataError"
      },
      "output": {
        "{{...}}": "{{temp.finalJob}}",
        "resultUrl": "{{if(temp.finalJob.result_url, temp.finalJob.result_url, undefined)}}"
      }
    }
  },
  {
    "condition": "{{!parameters.wait_for_completion || !temp.jobId}}",
    "response": {
      "output": "{{temp.accepted}}"
    }
  }
]
