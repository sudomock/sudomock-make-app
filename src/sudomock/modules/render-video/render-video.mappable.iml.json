[
  {
    "name": "input_mode",
    "label": "Input mode",
    "type": "select",
    "options": {
      "store": [
        {
          "label": "Render",
          "value": "render",
          "nested": [
            {
              "name": "mockup_uuid",
              "label": "Mockup",
              "type": "select",
              "required": true,
              "mode": "edit",
              "options": "rpc://listMockups",
              "help": "Choose a mockup or map its UUID."
            },
            {
              "name": "smart_objects",
              "label": "Smart objects",
              "type": "array",
              "spec": [
                {
                  "name": "uuid",
                  "label": "Smart object",
                  "type": "select",
                  "required": true,
                  "mode": "edit",
                  "options": "rpc://listSmartObjects?mockup_uuid={{parameters.mockup_uuid}}"
                },
                {
                  "name": "asset",
                  "label": "Asset",
                  "type": "collection",
                  "spec": [
                    {
                      "name": "url",
                      "label": "Asset URL",
                      "type": "url",
                      "required": true
                    },
                    {
                      "name": "fit",
                      "label": "Fit",
                      "type": "select",
                      "options": [
                        {
                          "label": "Fill",
                          "value": "fill"
                        },
                        {
                          "label": "Fit",
                          "value": "fit"
                        },
                        {
                          "label": "Crop",
                          "value": "crop"
                        }
                      ],
                      "default": "fill"
                    },
                    {
                      "name": "size",
                      "label": "Size",
                      "type": "collection",
                      "spec": [
                        {
                          "name": "width",
                          "label": "Width",
                          "type": "integer",
                          "validate": {
                            "min": 1
                          }
                        },
                        {
                          "name": "height",
                          "label": "Height",
                          "type": "integer",
                          "validate": {
                            "min": 1
                          }
                        }
                      ],
                      "advanced": true
                    },
                    {
                      "name": "position",
                      "label": "Position",
                      "type": "collection",
                      "spec": [
                        {
                          "name": "top",
                          "label": "Top",
                          "type": "number"
                        },
                        {
                          "name": "left",
                          "label": "Left",
                          "type": "number"
                        }
                      ],
                      "advanced": true
                    },
                    {
                      "name": "tile",
                      "label": "Tile",
                      "type": "boolean",
                      "help": "Repeat the artwork as a pattern across the whole smart object. size is one tile, fit places the artwork inside each tile, and position sets where the grid starts. Requires size.",
                      "advanced": true
                    },
                    {
                      "name": "tile_spacing",
                      "label": "Tile spacing",
                      "type": "number",
                      "help": "Gap between tiles as a percentage of the tile size, 0 to 100. The horizontal gap is that percent of the tile width, the vertical gap that percent of the tile height. Used only when tile is true.",
                      "validate": {
                        "min": 0,
                        "max": 100
                      },
                      "advanced": true
                    }
                  ],
                  "required": true
                }
              ],
              "required": true,
              "validate": {
                "minItems": 1
              }
            },
            {
              "name": "export_options",
              "label": "Export options",
              "type": "collection",
              "spec": [
                {
                  "name": "image_format",
                  "label": "Image format",
                  "type": "select",
                  "options": [
                    {
                      "label": "WebP",
                      "value": "webp"
                    },
                    {
                      "label": "PNG",
                      "value": "png"
                    },
                    {
                      "label": "JPG",
                      "value": "jpg"
                    }
                  ],
                  "default": "webp"
                },
                {
                  "name": "image_size",
                  "label": "Image size",
                  "type": "integer",
                  "default": 2048,
                  "validate": {
                    "min": 100,
                    "max": 10000
                  }
                },
                {
                  "name": "quality",
                  "label": "Quality",
                  "type": "integer",
                  "default": 90,
                  "validate": {
                    "min": 1,
                    "max": 100
                  }
                },
                {
                  "name": "dpi",
                  "label": "DPI",
                  "type": "integer",
                  "validate": {
                    "min": 72,
                    "max": 2400
                  }
                }
              ],
              "advanced": true
            }
          ]
        },
        {
          "label": "Image",
          "value": "image",
          "nested": [
            {
              "name": "image_url",
              "label": "Image URL",
              "type": "url",
              "required": true
            }
          ]
        }
      ]
    },
    "required": true,
    "default": "render"
  },
  {
    "name": "webhook",
    "label": "Webhook",
    "type": "collection",
    "spec": [
      {
        "name": "url",
        "label": "URL",
        "type": "url",
        "required": true,
        "help": "One-off completion callback URL."
      }
    ]
  },
  {
    "name": "video",
    "label": "Video options",
    "type": "collection",
    "spec": [
      {
        "name": "duration_seconds",
        "label": "Duration",
        "type": "integer",
        "default": 4,
        "validate": {
          "min": 1,
          "max": 15
        },
        "help": "Duration in seconds. The automatic model supports 4 or 6 seconds; model overrides must use a duration supported by that model."
      },
      {
        "name": "audio",
        "label": "Audio",
        "type": "boolean",
        "default": false
      },
      {
        "name": "motion",
        "label": "Motion",
        "type": "select",
        "options": [
          {
            "label": "Ambient",
            "value": "ambient"
          },
          {
            "label": "Showcase",
            "value": "showcase"
          }
        ],
        "default": "ambient"
      },
      {
        "name": "advanced_model",
        "label": "Advanced model",
        "type": "text"
      }
    ],
    "advanced": true
  },
  {
    "name": "wait_for_completion",
    "label": "Wait for completion",
    "type": "boolean",
    "default": false
  },
  {
    "name": "poll_timeout",
    "label": "Polling timeout",
    "type": "integer",
    "default": 300,
    "validate": {
      "min": 5,
      "max": 300
    },
    "visible": "{{parameters.wait_for_completion}}",
    "help": "Maximum wait in seconds. SudoMock uses Make's extended timeout for long-running video, image, and media-generation jobs."
  },
  {
    "name": "idempotency_key",
    "label": "Idempotency key",
    "type": "text",
    "advanced": true,
    "validate": {
      "max": 255
    },
    "help": "Optional retry-stable key that prevents duplicate jobs and duplicate credit charges."
  }
]
