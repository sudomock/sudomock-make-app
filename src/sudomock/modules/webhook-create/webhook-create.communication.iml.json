{
  "url": "/webhook-endpoints",
  "method": "POST",
  "body": {
    "url": "{{parameters.url}}",
    "description": "{{parameters.description}}",
    "event_types": "{{if(length(parameters.event_types) > 0, parameters.event_types, undefined)}}",
    "event_naming": "{{ifempty(parameters.event_naming, undefined)}}"
  },
  "response": {
    "output": "{{body}}"
  }
}
