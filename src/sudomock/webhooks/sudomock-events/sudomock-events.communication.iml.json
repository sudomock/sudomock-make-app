{
  "temp": {
    "valid": "{{now < addSeconds(parseDate(headers.`x-sudomock-timestamp`, 'X'), 300) && addSeconds(parseDate(headers.`x-sudomock-timestamp`, 'X'), -300) < now && headers.`x-sudomock-signature` == sha256(headers.`x-sudomock-timestamp` + '.' + sudomockSignedBody(body), 'hex', data.secret)}}"
  },
  "verification": {
    "condition": "{{!temp.valid}}",
    "respond": {
      "type": "json",
      "status": 400,
      "body": {
        "message": "Invalid signature"
      }
    }
  },
  "respond": {
    "type": "json",
    "status": 200,
    "body": {
      "message": "Accepted"
    }
  },
  "output": "{{body}}"
}
